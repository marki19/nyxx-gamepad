<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/robotCarRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B0C10">

    <!-- Top Navigation & Status Bar -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="12dp"
        android:background="#12161F"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageButton
            android:id="@+id/btnBackToHome"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_back"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:tint="#C5C6C7"
            android:contentDescription="Back" />

        <TextView
            android:id="@+id/tvRobotTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Robot Car"
            android:fontFamily="sans-serif-black"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:letterSpacing="0.02"
            android:paddingStart="8dp"
            android:paddingEnd="12dp" />

        <View
            android:id="@+id/viewStatusDot"
            android:layout_width="7dp"
            android:layout_height="7dp"
            android:background="@drawable/bg_circle_icon"
            android:backgroundTint="#FF5C5C"
            android:layout_marginEnd="6dp" />

        <TextView
            android:id="@+id/tvConnectionStatus"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Disconnected"
            android:fontFamily="monospace"
            android:textColor="#8B949E"
            android:textSize="11sp" />

        <Button
            android:id="@+id/btnReconnect"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:text="Reconnect"
            android:textSize="10sp"
            android:fontFamily="sans-serif-medium"
            android:textColor="#66FCF1"
            android:background="@drawable/btn_interactive_selector"
            android:paddingHorizontal="10dp" />
    </LinearLayout>

    <!-- Main Landscape Dashboard (3 Columns) -->
    <LinearLayout
        android:id="@+id/layoutLandscapeDashboard"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:orientation="horizontal"
        android:padding="6dp"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- LEFT COLUMN: STEERING WHEEL & CONTROLS -->
        <LinearLayout
            android:id="@+id/layoutJoystickContainer"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.15"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:background="@drawable/bg_dark_card"
            android:padding="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="2dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="STEERING WHEEL"
                    android:fontFamily="monospace"
                    android:textColor="#8B949E"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.1" />

                <TextView
                    android:id="@+id/tvJoystickAngle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Center (0°)"
                    android:textColor="#66FCF1"
                    android:textSize="10sp"
                    android:fontFamily="monospace" />
            </LinearLayout>

            <!-- Interactive Racing Steering Wheel -->
            <com.nativegamepad.SteeringWheelView
                android:id="@+id/steeringWheel"
                android:layout_width="160dp"
                android:layout_height="160dp"
                android:layout_weight="1"
                android:layout_gravity="center" />

            <!-- Spin Controls -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginTop="4dp">

                <Button
                    android:id="@+id/btnSpinLeft"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:text="Spin Left"
                    android:textSize="10sp"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="#E6EDF3"
                    android:background="@drawable/btn_interactive_selector"
                    android:layout_marginEnd="4dp" />

                <Button
                    android:id="@+id/btnSpinStop"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="0.8"
                    android:text="Stop"
                    android:textSize="10sp"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="#FF5C5C"
                    android:background="@drawable/btn_stop_selector"
                    android:layout_marginEnd="4dp" />

                <Button
                    android:id="@+id/btnSpinRight"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:text="Spin Right"
                    android:textSize="10sp"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="#E6EDF3"
                    android:background="@drawable/btn_interactive_selector" />
            </LinearLayout>
        </LinearLayout>

        <!-- CENTER COLUMN: ACTIONS & TUNING -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.9"
            android:orientation="vertical"
            android:background="@drawable/bg_dark_card"
            android:padding="8dp"
            android:layout_marginHorizontal="6dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CONTROLS &amp; TUNING"
                android:fontFamily="monospace"
                android:textColor="#8B949E"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.1"
                android:layout_marginBottom="6dp" />

            <!-- Red Emergency Stop Button -->
            <Button
                android:id="@+id/btnModeStop"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:text="STOP"
                android:textSize="12sp"
                android:fontFamily="sans-serif-black"
                android:textColor="#FF5C5C"
                android:background="@drawable/btn_stop_selector"
                android:letterSpacing="0.1"
                android:layout_marginBottom="8dp" />

            <!-- Scrollable Tuning Sliders -->
            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:fillViewport="true"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- 1. Cruise Speed (Top-most) -->
                    <LinearLayout
                        android:id="@+id/cardSpeed"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:background="@drawable/bg_dark_card"
                        android:padding="6dp"
                        android:layout_marginBottom="6dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Cruise Speed"
                                android:textColor="#C5C6C7"
                                android:textSize="11sp"
                                android:fontFamily="sans-serif-medium" />

                            <TextView
                                android:id="@+id/tvSpeedValue"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="70 %"
                                android:textColor="#66FCF1"
                                android:textSize="11sp"
                                android:fontFamily="monospace"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <com.google.android.material.slider.Slider
                            android:id="@+id/sliderSpeed"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:valueFrom="0.0"
                            android:valueTo="100.0"
                            android:stepSize="1.0"
                            android:value="70.0"
                            app:thumbColor="#66FCF1"
                            app:trackColorActive="#45A29E"
                            app:trackColorInactive="#22FFFFFF" />
                    </LinearLayout>

                    <!-- 2. Obstacle Avoid Distance -->
                    <LinearLayout
                        android:id="@+id/cardDistance"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:background="@drawable/bg_dark_card"
                        android:padding="6dp"
                        android:layout_marginBottom="6dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Obstacle Avoid Distance"
                                android:textColor="#C5C6C7"
                                android:textSize="11sp"
                                android:fontFamily="sans-serif-medium" />

                            <TextView
                                android:id="@+id/tvDistanceValue"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="35 cm"
                                android:textColor="#66FCF1"
                                android:textSize="11sp"
                                android:fontFamily="monospace"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <com.google.android.material.slider.Slider
                            android:id="@+id/sliderDistance"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:valueFrom="10.0"
                            android:valueTo="100.0"
                            android:stepSize="1.0"
                            android:value="35.0"
                            app:thumbColor="#66FCF1"
                            app:trackColorActive="#45A29E"
                            app:trackColorInactive="#22FFFFFF" />
                    </LinearLayout>

                    <!-- 3. Follow Near Limit (Back Away) -->
                    <LinearLayout
                        android:id="@+id/cardFollowNear"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:background="@drawable/bg_dark_card"
                        android:padding="6dp"
                        android:layout_marginBottom="6dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Follow Near Limit (Back Away)"
                                android:textColor="#C5C6C7"
                                android:textSize="11sp"
                                android:fontFamily="sans-serif-medium" />

                            <TextView
                                android:id="@+id/tvFollowNearValue"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="5 cm"
                                android:textColor="#66FCF1"
                                android:textSize="11sp"
                                android:fontFamily="monospace"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <com.google.android.material.slider.Slider
                            android:id="@+id/sliderFollowNear"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:valueFrom="2.0"
                            android:valueTo="25.0"
                            android:stepSize="1.0"
                            android:value="5.0"
                            app:thumbColor="#66FCF1"
                            app:trackColorActive="#45A29E"
                            app:trackColorInactive="#22FFFFFF" />
                    </LinearLayout>

                    <!-- 4. Follow Catch Limit (Chase) -->
                    <LinearLayout
                        android:id="@+id/cardFollowFar"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:background="@drawable/bg_dark_card"
                        android:padding="6dp"
                        android:layout_marginBottom="6dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Follow Catch Limit (Chase)"
                                android:textColor="#C5C6C7"
                                android:textSize="11sp"
                                android:fontFamily="sans-serif-medium" />

                            <TextView
                                android:id="@+id/tvFollowFarValue"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="8 cm"
                                android:textColor="#66FCF1"
                                android:textSize="11sp"
                                android:fontFamily="monospace"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <com.google.android.material.slider.Slider
                            android:id="@+id/sliderFollowFar"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:valueFrom="4.0"
                            android:valueTo="40.0"
                            android:stepSize="1.0"
                            android:value="8.0"
                            app:thumbColor="#66FCF1"
                            app:trackColorActive="#45A29E"
                            app:trackColorInactive="#22FFFFFF" />
                    </LinearLayout>

                    <!-- 5. Follow Max Range (Ignore) -->
                    <LinearLayout
                        android:id="@+id/cardFollowRange"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:background="@drawable/bg_dark_card"
                        android:padding="6dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Follow Max Range (Ignore)"
                                android:textColor="#C5C6C7"
                                android:textSize="11sp"
                                android:fontFamily="sans-serif-medium" />

                            <TextView
                                android:id="@+id/tvFollowRangeValue"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="60 cm"
                                android:textColor="#66FCF1"
                                android:textSize="11sp"
                                android:fontFamily="monospace"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <com.google.android.material.slider.Slider
                            android:id="@+id/sliderFollowRange"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:valueFrom="20.0"
                            android:valueTo="150.0"
                            android:stepSize="5.0"
                            android:value="60.0"
                            app:thumbColor="#66FCF1"
                            app:trackColorActive="#45A29E"
                            app:trackColorInactive="#22FFFFFF" />
                    </LinearLayout>
                </LinearLayout>
            </ScrollView>

            <!-- Motion Controls (Air Move) -->
            <Button
                android:id="@+id/btnAirMove"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:text="Air Move"
                android:textSize="11sp"
                android:fontFamily="sans-serif-medium"
                android:textColor="#E6EDF3"
                android:background="@drawable/btn_interactive_selector"
                android:layout_marginTop="6dp" />
        </LinearLayout>

        <!-- RIGHT COLUMN: MODES & PEDALS -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.25"
            android:orientation="vertical"
            android:background="@drawable/bg_dark_card"
            android:padding="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="AUTONOMOUS MODES"
                android:fontFamily="monospace"
                android:textColor="#8B949E"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.1"
                android:layout_marginBottom="3dp" />

            <!-- Compact 2x2 Grid of 4 Modes (Minimized) -->
            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="2"
                android:rowCount="2"
                android:alignmentMode="alignMargins"
                android:columnOrderPreserved="false"
                android:useDefaultMargins="false">

                <Button
                    android:id="@+id/btnModeAvoid"
                    android:layout_width="0dp"
                    android:layout_height="30dp"
                    android:layout_columnWeight="1"
                    android:text="Obstacle Avoid"
                    android:textSize="9sp"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="#E6EDF3"
                    android:background="@drawable/btn_interactive_selector"
                    android:layout_margin="2dp" />

                <Button
                    android:id="@+id/btnModeFollow"
                    android:layout_width="0dp"
                    android:layout_height="30dp"
                    android:layout_columnWeight="1"
                    android:text="Object Follow"
                    android:textSize="9sp"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="#E6EDF3"
                    android:background="@drawable/btn_interactive_selector"
                    android:layout_margin="2dp" />

                <Button
                    android:id="@+id/btnModeLine"
                    android:layout_width="0dp"
                    android:layout_height="30dp"
                    android:layout_columnWeight="1"
                    android:text="Line Tracking"
                    android:textSize="9sp"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="#E6EDF3"
                    android:background="@drawable/btn_interactive_selector"
                    android:layout_margin="2dp" />

                <Button
                    android:id="@+id/btnModeLight"
                    android:layout_width="0dp"
                    android:layout_height="30dp"
                    android:layout_columnWeight="1"
                    android:text="Light Seeking"
                    android:textSize="9sp"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="#E6EDF3"
                    android:background="@drawable/btn_interactive_selector"
                    android:layout_margin="2dp" />
            </GridLayout>

            <!-- DRIVE PEDALS (EXPANDED TO FILL SPACE) -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DRIVE PEDALS"
                android:fontFamily="monospace"
                android:textColor="#8B949E"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.1"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="3dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <!-- Brake / Reverse Pedal -->
                <com.nativegamepad.RacingPedalView
                    android:id="@+id/btnPedalBrake"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp" />

                <!-- Gas / Forward Acceleration Pedal -->
                <com.nativegamepad.RacingPedalView
                    android:id="@+id/btnPedalGas"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1.2" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>

    <!-- Dedicated Portrait Air Move Motion Screen -->
    <LinearLayout
        android:id="@+id/layoutPortraitMotion"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="#0B0C10"
        android:padding="20dp"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Top Header Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <Button
                android:id="@+id/btnMotionBack"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="← Remote"
                android:textSize="12sp"
                android:fontFamily="sans-serif-medium"
                android:textColor="#66FCF1"
                android:background="@drawable/btn_interactive_selector"
                android:paddingHorizontal="14dp" />

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <View
                android:id="@+id/viewMotionStatusDot"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:background="@drawable/bg_circle_icon"
                android:backgroundTint="#FF5C5C"
                android:layout_marginEnd="6dp" />

            <TextView
                android:id="@+id/tvMotionStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Disconnected"
                android:fontFamily="monospace"
                android:textColor="#C5C6C7"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Title & Instruction -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="AIR MOVE"
            android:fontFamily="sans-serif-black"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:letterSpacing="0.08"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="2dp" />

        <TextView
            android:id="@+id/tvMotionInstruction"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Hold button to calibrate &amp; tilt phone to drive"
            android:fontFamily="sans-serif"
            android:textColor="#8B949E"
            android:textSize="11sp"
            android:gravity="center"
            android:layout_marginBottom="8dp" />

        <!-- Joystick Radar Visualizer (Above) -->
        <LinearLayout
            android:id="@+id/layoutJoystickRadar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:layout_marginBottom="4dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="▲ FORWARD (90°)"
                android:fontFamily="monospace"
                android:textColor="#45A29E"
                android:textSize="10sp"
                android:textStyle="bold"
                android:layout_marginBottom="2dp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="◄ LEFT\n(180°)"
                    android:fontFamily="monospace"
                    android:textColor="#45A29E"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:layout_marginEnd="6dp" />

                <com.nativegamepad.VirtualJoystickView
                    android:id="@+id/motionJoystickRadar"
                    android:layout_width="160dp"
                    android:layout_height="160dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="RIGHT ►\n(0°)"
                    android:fontFamily="monospace"
                    android:textColor="#45A29E"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:layout_marginStart="6dp" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="▼ REVERSE (-90°)"
                android:fontFamily="monospace"
                android:textColor="#45A29E"
                android:textSize="10sp"
                android:textStyle="bold"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <!-- Hold Button Area (Moved below joystick) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <Button
                android:id="@+id/btnHoldToDrive"
                android:layout_width="140dp"
                android:layout_height="140dp"
                android:text="HOLD\nTO MOVE"
                android:textSize="16sp"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="0.06"
                android:textColor="#FFFFFF"
                android:gravity="center"
                android:background="@drawable/btn_circle_hold" />

            <TextView
                android:id="@+id/tvSuperPositionStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Calibrates zero position on every hold"
                android:fontFamily="sans-serif"
                android:textColor="#66FCF1"
                android:textSize="11sp"
                android:layout_marginTop="8dp" />
        </LinearLayout>

        <!-- Telemetry & Speed Setting Card (Bottom) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_dark_card"
            android:padding="12dp"
            android:layout_marginTop="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvMotionTelemetry"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Direction: Center (Stop)"
                    android:fontFamily="monospace"
                    android:textColor="#66FCF1"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvMotionPacket"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Packet: %S"
                    android:fontFamily="monospace"
                    android:textColor="#8B949E"
                    android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="6dp">

                <TextView
                    android:id="@+id/tvMotionSpeedLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Cruise Speed: 75%"
                    android:fontFamily="monospace"
                    android:textColor="#C5C6C7"
                    android:textSize="11sp" />

                <com.google.android.material.slider.Slider
                    android:id="@+id/sliderMotionSpeed"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:valueFrom="0.0"
                    android:valueTo="100.0"
                    android:stepSize="1.0"
                    android:value="70.0"
                    app:trackColorActive="#45A29E"
                    app:trackColorInactive="#1F2833"
                    app:thumbColor="#66FCF1"
                    app:haloColor="#3366FCF1" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
