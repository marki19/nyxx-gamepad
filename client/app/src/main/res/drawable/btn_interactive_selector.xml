<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Pressed state (actively touching) -->
    <item android:state_pressed="true">
        <shape>
            <solid android:color="#7745A29E" />
            <corners android:radius="8dp" />
            <stroke android:width="1.5dp" android:color="#66FCF1" />
        </shape>
    </item>
    <!-- Selected state (active mode) -->
    <item android:state_selected="true">
        <shape>
            <solid android:color="#45A29E" />
            <corners android:radius="8dp" />
            <stroke android:width="2dp" android:color="#66FCF1" />
        </shape>
    </item>
    <!-- Focused state -->
    <item android:state_focused="true">
        <shape>
            <solid android:color="#3345A29E" />
            <corners android:radius="8dp" />
            <stroke android:width="1.5dp" android:color="#66FCF1" />
        </shape>
    </item>
    <!-- Normal state -->
    <item>
        <shape>
            <solid android:color="#161B22" />
            <corners android:radius="8dp" />
            <stroke android:width="1dp" android:color="#2A3240" />
        </shape>
    </item>
</selector>
